* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
# The vendored browser libraries stay byte for byte as their packages published them, on every checkout (a Windows one
# would otherwise get CRLF): each file's SHA-256 is the one app/public/vendor/VENDOR.json records.
app/public/vendor/** -text
# The audit verifier's files carry LF on every checkout, so a release's verifier is the same bytes whichever system
# built it (verify-audit.js also reads its page parts as LF, which the page's CSP hashes need).
app/verify/** text eol=lf
