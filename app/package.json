{
  "name": "agmessage",
  "version": "0.6.0",
  "description": "Messaging, displays and show-network links for live events: halls, crews, presenters and their screens.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node supervise.js",
    "dev": "node server.js",
    "test": "node test/run-tests.js --test \"test/*.test.js\"",
    "coverage": "node test/run-tests.js --test --experimental-test-coverage --test-coverage-include=server.js --test-coverage-include=supervise.js --test-coverage-include=launch.js --test-coverage-include=machine.js --test-coverage-include=\"lib/**\" --test-coverage-include=\"verify/**\" --test-coverage-include=public/zipcore.js --test-coverage-include=public/imagecore.js --test-coverage-include=public/linecore.js --test-coverage-include=public/wordpages.js --test-coverage-include=public/docmodel.mjs --test-coverage-lines=97 --test-coverage-branches=88 --test-coverage-functions=94 \"test/*.test.js\"",
    "lint": "cd .. && eslint .",
    "secrets": "node ../tools/scan-secrets.js",
    "audit": "npm audit --omit=dev --audit-level=high && npm audit signatures && node ../tools/vendor-audit.js",
    "check": "npm run lint && npm run secrets && npm run coverage",
    "smoke": "node test/run-tests.js test/browser-smoke.js",
    "version:print": "node ../tools/stamp-build.js --print"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "agmessage": {
    "runBase": 103
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "supports-color": "^8.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4"
  }
}
